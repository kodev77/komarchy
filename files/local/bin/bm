#!/usr/bin/env bash
# bm — bookmark manager entry point.
#
#   bm              Ensure chromium (with CDP) is running, then run the TUI
#                   inline in the current terminal. Exits when the TUI exits.
#   bm focus        Focus the bm window if running; else spawn one. Meant for
#                   hyprland keybinds where there's no parent terminal.
#   bm browser      Focus the bm-launched chromium window (PID-based).
#   bm open <url>   Activate URL if already open, else open a new tab.
#   bm save         Save the currently focused chromium tab.
#   bm list         Print saved tabs as JSON.
#   bm rm <url>     Remove a saved tab by URL.
#   bm workspace …  Manage workspaces (list/create/rm/switch).
#   bm next         Cycle to next chromium tab (keeps current window focus).
#   bm prev         Cycle to previous chromium tab (keeps current window focus).

set -euo pipefail

CDP_PORT="${BM_CDP_PORT:-9222}"
PROFILE_DIR="$HOME/.config/bm/profile"
ALACRITTY_CONFIG="$HOME/.config/alacritty/bm.toml"

BM_BIN="${BM_BIN:-$HOME/.local/bin/bm-py}"

run_bm_py() {
  "$BM_BIN" "$@"
}

cdp_up() {
  # --max-time 2: Arch's curl is built without c-ares, so sub-second timeouts
  # fall back to SIGALRM (1s granularity) and curl aborts immediately with
  # "remaining timeout … too small to resolve via SIGALRM method", so cdp_up
  # would always return false even when chromium's CDP was live.
  curl -sSf -o /dev/null --max-time 2 "http://localhost:${CDP_PORT}/json/version" 2>/dev/null
}

clear_crash_marker() {
  # Mark the prior shutdown as clean (keeps persistent cookies safe
  # through SIGTERM) and set restore_on_startup=1 so session cookies
  # survive. The restored tab set is wiped post-launch by bm-py's
  # _wait_for_chromium_ready (which calls launcher.clean_tabs once
  # CDP is up) on cold launches.
  local prefs="$PROFILE_DIR/Default/Preferences"
  [[ -f "$prefs" ]] || return 0
  command -v python3 >/dev/null 2>&1 || return 0
  python3 - "$prefs" <<'PY'
import json, sys
p = sys.argv[1]
try:
    with open(p) as f:
        d = json.load(f)
except Exception:
    sys.exit(0)
d.setdefault("profile", {})["exit_type"] = "Normal"
d["profile"]["exited_cleanly"] = True
d.setdefault("session", {})["restore_on_startup"] = 1
with open(p, "w") as f:
    json.dump(d, f)
PY
}

launch_chromium() {
  mkdir -p "$PROFILE_DIR"
  clear_crash_marker
  setsid chromium \
    --remote-debugging-port="$CDP_PORT" \
    --user-data-dir="$PROFILE_DIR" \
    --no-first-run \
    --no-default-browser-check \
    --restore-last-session \
    --disable-session-crashed-bubble \
    </dev/null >/dev/null 2>&1 &
  disown
}

is_bm_running() {
  # True iff the bm TUI's PID file points at a live process. Used by
  # the keybind dispatch in `case` below so each binding either runs
  # its action against the running bm, or spawns bm via cmd_focus
  # when it isn't running yet.
  local pid
  pid="$(cat "$HOME/.config/bm/bm.pid" 2>/dev/null)" || return 1
  [[ -n "$pid" ]] || return 1
  kill -0 "$pid" 2>/dev/null
}

is_bm_focused() {
  # True iff the bm sidebar (ghostty + bm-py) is the currently active
  # hyprland window. Used by the `workspace next` keybind to gate the
  # workspace cycle: pressing Super+Alt+; from another app focuses bm
  # first; pressing it again with bm focused triggers the cycle. This
  # avoids "I pressed it just to come over here, didn't mean to cycle."
  command -v hyprctl >/dev/null 2>&1 || return 1
  local cls
  cls="$(hyprctl activewindow -j 2>/dev/null | python3 -c "
import json, sys
try:
    print(json.load(sys.stdin).get('class', ''))
except Exception:
    pass
" 2>/dev/null)"
  [[ "$cls" == "com.ko.bm" ]]
}

is_chromium_focused() {
  # True iff the bm-launched chromium is the currently active hyprland
  # window. Same focus-then-cycle gate as is_bm_focused, but for the
  # tab cycle (Super+Alt+J/K). Matches by PID against chromium.pid so
  # any other chromium window the user has open doesn't satisfy the
  # check.
  command -v hyprctl >/dev/null 2>&1 || return 1
  local cpid actpid
  cpid="$(cat "$HOME/.config/bm/chromium.pid" 2>/dev/null)" || return 1
  [[ -n "$cpid" ]] || return 1
  actpid="$(hyprctl activewindow -j 2>/dev/null | python3 -c "
import json, sys
try:
    print(json.load(sys.stdin).get('pid', ''))
except Exception:
    pass
" 2>/dev/null)"
  [[ -n "$actpid" && "$actpid" == "$cpid" ]]
}

focus_bm_chromium() {
  # Dispatch hyprland focus to the bm-launched chromium by PID. Same
  # logic as `bm browser` (Python entry) but inlined in bash so the
  # next/prev cycle path doesn't pay for a second python startup. PID
  # is exact — chromium ignores --class on Wayland, so class-based
  # matching can't distinguish bm chromium from other chromium windows.
  command -v hyprctl >/dev/null 2>&1 || return 0
  local pid
  pid="$(cat "$HOME/.config/bm/chromium.pid" 2>/dev/null)" || return 0
  [[ -n "$pid" ]] || return 0
  kill -0 "$pid" 2>/dev/null || return 0
  hyprctl dispatch focuswindow "pid:$pid" >/dev/null 2>&1 || true
}

write_chromium_pid() {
  # Persist the bm-spawned chromium's PID so `bm browser` can dispatch
  # hyprland focus by pid:NNN — class-based matching is unreliable
  # because chromium ignores --class on Wayland (hardcoded app_id).
  #
  # `setsid` forks before exec, so $! captures the setsid wrapper that
  # exits immediately, not chromium. Instead, locate the main chromium
  # process by argument: it has --user-data-dir set but does NOT have
  # --type= (renderer / zygote / gpu / utility children all carry
  # --type=, so excluding them isolates the main browser process).
  #
  # Brief retry: on cold launch we run right after launch_chromium &
  # disown, when chromium's fork() has completed but exec might not
  # have set the cmdline yet — pgrep can race. 3×50ms covers that
  # without adding meaningful latency to the warm path (where pgrep
  # finds the PID on the first try).
  local cpid i
  for i in 1 2 3; do
    cpid="$(pgrep -af -- "--user-data-dir=$PROFILE_DIR" 2>/dev/null | grep -v -- "--type=" | head -1 | awk '{print $1}')"
    [[ -n "$cpid" ]] && break
    sleep 0.05
  done
  if [[ -n "$cpid" ]]; then
    mkdir -p "$HOME/.config/bm"
    echo "$cpid" > "$HOME/.config/bm/chromium.pid"
  fi
}

active_window_address() {
  hyprctl activewindow -j 2>/dev/null | python3 -c \
    'import json,sys; print(json.load(sys.stdin).get("address",""))' 2>/dev/null
}

self_ghostty_address() {
  # Find this script's containing ghostty terminal address by walking
  # our process ancestry. PID-based — doesn't depend on the new
  # window having received focus yet, which matters when ghostty was
  # just spawned by `bm focus` and hyprland's activewindow may still
  # report the previous focus (chromium, the launcher app, etc.).
  command -v hyprctl >/dev/null 2>&1 || return 1
  local pid="$$"
  local comm parent
  while (( pid > 1 )); do
    comm="$(ps -o comm= -p "$pid" 2>/dev/null | tr -d ' ')"
    if [[ "$comm" == "alacritty" ]]; then
      # Poll up to ~1.5s — ghostty/GTK4 + hyprland surface registration
      # can take several hundred ms on a cold start. The earlier 5×0.05
      # cap (250ms) was racing the window-mapped event and missing it,
      # which caused the async shrink_to_sidebar to silently no-op and
      # the bm window to stay at the default 50/50 dwindle split.
      local i
      for i in $(seq 1 30); do
        local addr
        addr="$(hyprctl clients -j 2>/dev/null | python3 -c "
import json, sys
target = int(sys.argv[1])
for c in json.load(sys.stdin):
    if c.get('pid') == target:
        print(c.get('address',''))
        break
" "$pid" 2>/dev/null)"
        if [[ -n "$addr" ]]; then
          echo "$addr"
          return 0
        fi
        sleep 0.05
      done
      return 1
    fi
    parent="$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')"
    [[ -n "$parent" && "$parent" != "$pid" && "$parent" != "0" ]] || return 1
    pid="$parent"
  done
  return 1
}

shrink_to_sidebar() {
  # Position + resize the bm window as a left-edge sidebar.
  #
  # Runs in a backgrounded subshell from cmd_interactive, so it does
  # its own window lookup (self_ghostty_address) rather than receiving
  # an address argument — keeping the polling out of cmd_interactive's
  # foreground exec path. $$ in the subshell is still the parent bm
  # bash's PID (subshells inherit $$), and after the parent exec's
  # into bm-py the PID resolves to bm-py whose ppid is ghostty — so
  # the ancestry walk finds ghostty either way.
  #
  # 1. movewindow l — dwindle places a new tile next to whichever window
  #    had focus when ghostty mapped, which can land bm anywhere on the
  #    screen. Nudging left is a no-op when bm is already leftmost.
  # 2. delta-resize loop (om37) — on hyprland 0.54+ `resizeactive exact`
  #    only resizes floating windows, so we compute the width delta
  #    from the current size and dispatch relative-resize, iterating
  #    until we converge within 10px of $width. Under dwindle with >2
  #    tiles hyprland clamps a single big delta and only resizes
  #    partway, so each pass closes the gap.
  local width="${BM_SIDEBAR_WIDTH:-300}"
  local addr
  addr="$(self_ghostty_address)"
  [[ -n "$addr" ]] || return 0
  command -v hyprctl >/dev/null 2>&1 || return 0
  hyprctl dispatch focuswindow address:"$addr" >/dev/null 2>&1 || true
  sleep 0.05
  # Iterate up to 8 times. On wide monitors (2K+) starting from a 50/50
  # tile means a delta of ~−2200, which hyprland silently clamps per
  # dispatch — so multiple passes are required to converge. Per-pass
  # 0.15s sleep gives hyprland's layout pipeline time to commit before
  # we re-query width (at 0.08s the next query returned the pre-resize
  # value and wasted an iteration). Per-iteration delta capped at ±800
  # because hyprland silently rejects very large deltas on tiled
  # windows; smaller chunks reliably commit. focuswindow + resizeactive
  # issued in a single hyprctl --batch transaction so the resizeactive
  # can't race a focus-steal from chromium spawning between dispatches.
  #
  # No movewindow l. In dwindle, `movewindow l` swaps the WINDOWS
  # between two slots while preserving the SLOTS — bm (300px left
  # slot) and chromium (~2200px right slot) trade positions but each
  # inherits the destination slot's size. Net effect: bm bounces back
  # to ~2200px and the resize work is undone. Whichever side dwindle
  # places bm on is fine; if explicit-left is needed, solve it via a
  # hyprland windowrule, not a post-hoc dispatch.
  local cur_w_ delta_ i
  for i in 1 2 3 4 5 6 7 8; do
    cur_w_=$(hyprctl clients -j 2>/dev/null | python3 -c "import json,sys; print(next((w['size'][0] for w in json.load(sys.stdin) if w.get('address')=='$addr'), 0))" 2>/dev/null) || cur_w_=0
    if [[ -z "$cur_w_" || "$cur_w_" -le 0 ]]; then
      break
    fi
    delta_=$(( width - cur_w_ ))
    if (( delta_ >= -10 && delta_ <= 10 )); then
      break
    fi
    if (( delta_ < -800 )); then delta_=-800; fi
    if (( delta_ > 800 )); then delta_=800; fi
    hyprctl --batch "dispatch focuswindow address:$addr ; dispatch resizeactive $delta_ 0" >/dev/null 2>&1 || true
    sleep 0.15
  done
  hyprctl dispatch focuswindow address:"$addr" >/dev/null 2>&1 || true
}

cmd_interactive() {
  if ! command -v chromium >/dev/null; then
    echo "chromium not installed" >&2
    exit 1
  fi
  if [[ ! -x "$BM_BIN" ]]; then
    echo "bm-py not installed — run the 019-bm-tool migration" >&2
    exit 1
  fi

  # Cold-launch chromium if needed, but do NOT wait for CDP here —
  # bm-py's _wait_for_chromium_ready (in BmApp.on_mount) drives CDP
  # readiness + clean_tabs asynchronously after the TUI paints, hiding
  # the ~1s chromium init behind user-visible content. BM_COLD_LAUNCH
  # signals to bm-py that this run spawned chromium fresh and the
  # post-restore clean_tabs sweep should fire (warm runs preserve
  # whatever tabs the user already had open).
  if ! cdp_up; then
    launch_chromium
    export BM_COLD_LAUNCH=1
  fi

  # Always (re)write chromium.pid — covers both fresh-launch and
  # bm-started-with-chromium-already-up. `bm browser` reads this file
  # for Super+Alt+L; without it the binding is a silent no-op.
  write_chromium_pid

  # Async sidebar placement: shrink_to_sidebar runs in a backgrounded
  # subshell — it does its own window-address lookup (so cmd_interactive
  # doesn't block on hyprland-registration polling) and overlaps with
  # bm-py's Textual startup (~500ms-1s) instead of being a serial
  # blocker before exec. The visual resize lands a moment AFTER the
  # TUI first paints, which is visually fine — content is already
  # there for the user to read while the window finds its width.
  ( shrink_to_sidebar ) >/dev/null 2>&1 &
  disown

  # Advertise "bm" as the terminal title (OSC 2) so the window is also
  # identifiable by title. Not required by `bm focus` (which uses process
  # ancestry), but nice for taskbars, wmctrl, etc.
  printf '\033]2;bm\007'

  # Run the TUI inline in the current terminal. `exec` replaces the script
  # so bash exits cleanly when the TUI does, dropping the user back at their
  # shell without an extra process in the tree.
  exec "$BM_BIN"
}

find_bm_ghostty_pid() {
  # Find a hyprland window of class com.ko.bm and return its pid. Used
  # by cmd_focus to decide whether to focus an existing bm or spawn a
  # new one. Replaces a prior `pgrep -x bm-py | head -1` + ancestry
  # walk: that picked the OLDEST bm-py, which on omarchy 3.7+ often
  # pointed to an orphan ghostty whose window had already been closed
  # — focus_hyprland_window_by_pid would then return 1 and cmd_focus
  # would spawn yet another ghostty even though a working bm window
  # already existed. Class-based lookup short-circuits the orphan trap.
  command -v hyprctl >/dev/null 2>&1 || return 1
  local pid
  pid="$(hyprctl clients -j 2>/dev/null | python3 -c "
import json, sys
for c in json.load(sys.stdin):
    if c.get('class') == 'com.ko.bm':
        print(c.get('pid', ''))
        break
" 2>/dev/null)"
  [[ -n "$pid" && "$pid" != "0" ]] || return 1
  echo "$pid"
}

focus_hyprland_window_by_pid() {
  local target_pid="$1"
  command -v hyprctl >/dev/null 2>&1 || return 1
  local addr
  addr="$(hyprctl clients -j 2>/dev/null | python3 -c "
import json, sys
target = int(sys.argv[1])
for c in json.load(sys.stdin):
    if c.get('pid') == target:
        print(c.get('address', ''))
        break
" "$target_pid")"
  [[ -n "$addr" ]] || return 1
  hyprctl dispatch focuswindow address:"$addr" >/dev/null 2>&1 || true
  return 0
}

cmd_focus() {
  # Focus the existing bm window if one is running; otherwise spawn a new
  # alacritty (with bm config) and run bm inside it. Intended for hyprland
  # keybinds where there's no parent terminal.
  #
  # Spawn case: setsid + disown the alacritty and return immediately.
  # cmd_interactive (running inside the new alacritty) handles the sidebar
  # placement asynchronously, so cmd_focus doesn't block waiting for the
  # window to register and resize.
  local ghostty_pid
  if ghostty_pid="$(find_bm_ghostty_pid)"; then
    if focus_hyprland_window_by_pid "$ghostty_pid"; then
      return 0
    fi
  fi
  if ! command -v alacritty >/dev/null; then
    echo "alacritty not installed" >&2
    exit 1
  fi
  setsid alacritty \
    --class com.ko.bm \
    --config-file="$ALACRITTY_CONFIG" \
    -e "$0" \
    </dev/null >/dev/null 2>&1 &
  disown
}

case "${1:-}" in
  ""|tui)
    cmd_interactive
    ;;
  focus)
    # Super+Alt+H: focus bm sidebar. cmd_focus handles spawn-if-not-
    # running and calls hyprctl dispatch focuswindow address:NNN
    # which auto-switches the user to bm's hyprland workspace.
    cmd_focus
    ;;
  browser)
    # Super+Alt+L: focus the bm chromium window. PID-based dispatch
    # (chromium ignores --class on Wayland). When bm isn't running
    # yet, fall through to cmd_focus to spawn the whole stack — bm
    # then chromium — so the keybind opens what isn't open instead
    # of being a silent no-op.
    if is_bm_running; then
      run_bm_py "$@"
    else
      cmd_focus
    fi
    ;;
  next|prev)
    # Super+Alt+J/K. Two-press model:
    #   1st press (neither bm nor chromium focused): focus chromium,
    #     no cycle. User just wanted to land on chromium without their
    #     cursor skipping past their current tab.
    #   2nd press (already in the bm context — either bm sidebar OR
    #     chromium has focus): signal the cycle. The user is already
    #     looking at the right surface; no focus shuffle needed.
    # Spawn fallback when bm isn't running.
    if is_bm_running; then
      if is_chromium_focused || is_bm_focused; then
        run_bm_py "$@"
      else
        focus_bm_chromium
      fi
    else
      cmd_focus
    fi
    ;;
  workspace)
    # `bm workspace next` (Super+Alt+;) — two-press model, same shape as
    # next/prev: if the user is already in the bm context (bm sidebar OR
    # the bm chromium has focus) cycle workspaces in place; otherwise
    # the first press only focuses bm. Treating bm-chromium-focused as
    # "in context" keeps the user from getting yanked off chromium just
    # to cycle workspaces — they're already looking at the right stack.
    # Other workspace subcommands (list / create / rm / switch) have
    # no focus side effects.
    case "${2:-}" in
      next)
        if is_bm_running; then
          if is_bm_focused || is_chromium_focused; then
            run_bm_py "$@"
          else
            cmd_focus
          fi
        else
          cmd_focus
        fi
        ;;
      *)
        run_bm_py "$@"
        ;;
    esac
    ;;
  open|save|list|rm)
    run_bm_py "$@"
    ;;
  -h|--help|help)
    sed -n '3,12p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *)
    echo "unknown subcommand: $1" >&2
    echo "run: bm --help" >&2
    exit 1
    ;;
esac
